<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default: "인공지능 기초수학" }}</title>
  <meta name="description" content="{{ description | default: site.siteDescription }}">
  {% if site.faviconUrl %}
    <link rel="icon" type="{% if site.faviconUrl contains '.svg' %}image/svg+xml{% else %}image/png{% endif %}" href="{{ site.faviconUrl }}">
  {% endif %}

  <!-- KaTeX 수학 공식 지원 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">

  <!-- Bauhaus 테마 스타일시트 -->
  <link rel="stylesheet" href="/assets/css/bauhaus.css">

  <script src="/assets/js/theme.js"></script>
  <script src="/assets/js/search.js" defer></script>
</head>
<body>

  <!-- 바우하우스 상단 네비게이션 헤더 -->
  <header class="bh-header">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <button id="menu-toggle" class="bh-btn bh-mobile-menu-btn" aria-label="메뉴 열기">
        ☰
      </button>
      <a href="/" class="bh-brand">
        <div class="bh-shapes-badge">
          <div class="bh-shape-square"></div>
          <div class="bh-shape-circle"></div>
          <div class="bh-shape-triangle"></div>
        </div>
        <span class="bh-brand-text">{{ site.siteTitle | default: "인공지능 기초수학" }}</span>
      </a>
    </div>

    <div class="bh-actions">
      <button id="search-open" class="bh-btn" title="검색 (/)">
        <span>🔍</span>
        <span class="btn-text bh-search-text">검색</span>
      </button>
      <button id="theme-toggle" class="bh-btn" title="테마 변경">
        <span>🌙</span>
        <span class="btn-text">Dark</span>
      </button>
    </div>
  </header>

  <!-- 본문 컨테이너 -->
  <div class="bh-container">
    <!-- 사이드바 (단원 목차) -->
    <aside class="bh-sidebar">
      <div class="bh-sidebar-title">목차 (Contents)</div>
      <nav>
        <ul class="bh-nav-list">
          <li class="bh-nav-item {% if page.url == '/' %}active{% endif %}">
            <a href="/">📖 소개</a>
          </li>
          {% for item in collections.chapters %}
            <li class="bh-nav-item {% if page.url == item.url %}active{% endif %}">
              <a href="{{ item.url }}">{{ item.data.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </aside>

    <!-- 메인 콘텐츠 영역 -->
    <main class="bh-main-content">
      {{ content }}

      <!-- 바우하우스 스타일 푸터 -->
      <footer class="bh-footer">
        <div class="bh-footer-inner">
          <div class="bh-footer-text">
            {{ site.footerText | default: "© 2026 인공지능 기초수학 교과서." }}
          </div>
          {% if site.footerLinks %}
            <div class="bh-footer-links">
              {% for link in site.footerLinks %}
                <a href="{{ link.url }}" target="_blank" class="bh-footer-link">{{ link.text }}</a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </footer>
    </main>
  </div>

  <!-- 검색 모달 -->
  <div id="search-modal" class="bh-modal-backdrop">
    <div class="bh-modal">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
        <h3 style="font-size: 1.1rem; font-weight: 900;">단원 및 내용 검색</h3>
        <button id="search-close" class="bh-btn" style="padding: 0.2rem 0.5rem;">✕</button>
      </div>
      <input type="text" id="search-input" class="bh-search-input" placeholder="검색어를 입력하세요... (예: 행렬, 디지털, 퍼셉트론)">
      <ul id="search-results" class="bh-search-results"></ul>
    </div>
  </div>

</body>
</html>
