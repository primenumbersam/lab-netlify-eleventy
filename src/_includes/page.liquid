---
layout: base.liquid
---

<article class="bh-article">
  <header class="bh-article-header">
    {% if tags contains "chapter" or eleventyNavigation.order or pdf %}
    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 0.85rem;">
      {% if eleventyNavigation.order %}
        <span class="bh-tag" style="margin-bottom: 0;">CHAPTER {{ eleventyNavigation.order }}</span>
      {% endif %}

      {% if tags contains "chapter" %}
      <a href="{{ page.url }}slide/" target="_blank" class="bh-btn bh-btn-primary" style="padding: 0.2rem 0.6rem; font-size: 0.78rem; text-decoration: none;" title="발표용 전체화면 슬라이드 열람">
        <span>📽️ Slide</span>
        <span>↗</span>
      </a>
      {% endif %}

      {% if pdf %}
      <a href="/pdf/{{ pdf }}" target="_blank" class="bh-btn bh-btn-accent" style="padding: 0.2rem 0.6rem; font-size: 0.78rem; text-decoration: none;" title="인쇄용 수식 조판 PDF 열람">
        <span>📄 PDF (Detailed)</span>
        <span>↗</span>
      </a>
      {% endif %}
    </div>
    {% endif %}

    <h1 class="bh-article-title">{{ title }}</h1>
    {% if description %}
      <p class="bh-article-desc">{{ description }}</p>
    {% endif %}
  </header>

  <div class="bh-content">
    {{ content }}
  </div>
</article>
